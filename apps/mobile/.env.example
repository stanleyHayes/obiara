# Public build configuration. Configure these in each EAS environment.
EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
EXPO_PUBLIC_API_BASE_URL=https://api.example.com
EXPO_PUBLIC_SITE_URL=https://www.example.com

# Must match preview, staging, or production for release builds.
OBIARA_RELEASE_CHANNEL=preview
