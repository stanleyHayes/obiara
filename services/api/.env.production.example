# Render Environment variables for obiara-api-production.
# Do not commit real values. Generate a unique random value of at least 32
# bytes for every HMAC secret. Rotation timestamps must be current RFC3339 UTC.
APP_ENV=production
MONGO_CONNECT_TIMEOUT=10s
SHUTDOWN_TIMEOUT=20s
MONGODB_DATABASE=obiara_production
MONGODB_URI=REPLACE_WITH_API_LEAST_PRIVILEGE_MONGODB_URI
MONGODB_URI_ROTATED_AT=REPLACE_WITH_RFC3339_UTC
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false
RESEND_WEBHOOK_SECRET=REPLACE_WITH_RESEND_SIGNING_SECRET
RESEND_WEBHOOK_SECRET_ROTATED_AT=REPLACE_WITH_RFC3339_UTC
LIVENESS_HMAC_SECRET=REPLACE_WITH_UNIQUE_RANDOM_VALUE_AT_LEAST_32_BYTES
LIVENESS_HMAC_SECRET_ROTATED_AT=REPLACE_WITH_RFC3339_UTC
COMMERCE_HMAC_SECRET=REPLACE_WITH_UNIQUE_RANDOM_VALUE_AT_LEAST_32_BYTES
COMMERCE_HMAC_SECRET_ROTATED_AT=REPLACE_WITH_RFC3339_UTC
ADMIN_HMAC_SECRET=REPLACE_WITH_UNIQUE_RANDOM_VALUE_AT_LEAST_32_BYTES
ADMIN_HMAC_SECRET_ROTATED_AT=REPLACE_WITH_RFC3339_UTC
NNOBOA_INVITE_SECRET=REPLACE_WITH_UNIQUE_RANDOM_VALUE_AT_LEAST_32_BYTES
NNOBOA_INVITE_SECRET_ROTATED_AT=REPLACE_WITH_RFC3339_UTC
SEED_HMAC_SECRET=REPLACE_WITH_UNIQUE_RANDOM_VALUE_AT_LEAST_32_BYTES
SEED_HMAC_SECRET_ROTATED_AT=REPLACE_WITH_RFC3339_UTC
CIRCLE_HMAC_SECRET=REPLACE_WITH_UNIQUE_RANDOM_VALUE_AT_LEAST_32_BYTES
CIRCLE_HMAC_SECRET_ROTATED_AT=REPLACE_WITH_RFC3339_UTC
FEATURE_SOW_ENABLED=true
FEATURE_FIRES_ENABLED=true
FEATURE_PAYMENTS_ENABLED=false
FEATURE_GATE_ENABLED=true
FEATURE_AI_ENABLED=false
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
