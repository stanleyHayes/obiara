# Render Environment variables for obiara-api-production.
# Do not commit real values. Generate a unique random value of at least 32
# bytes for every HMAC secret. Rotation timestamps must be current RFC3339 UTC.
APP_ENV=production
MONGO_CONNECT_TIMEOUT=30s
SHUTDOWN_TIMEOUT=20s
MONGODB_DATABASE=obiara_production
MONGODB_URI=REPLACE_WITH_API_LEAST_PRIVILEGE_MONGODB_URI
MONGODB_URI_ROTATED_AT=REPLACE_WITH_RFC3339_UTC
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false
RESEND_WEBHOOK_SECRET=REPLACE_WITH_RESEND_SIGNING_SECRET
RESEND_WEBHOOK_SECRET_ROTATED_AT=REPLACE_WITH_RFC3339_UTC
LIVENESS_HMAC_SECRET=REPLACE_WITH_UNIQUE_RANDOM_VALUE_AT_LEAST_32_BYTES
LIVENESS_HMAC_SECRET_ROTATED_AT=REPLACE_WITH_RFC3339_UTC
COMMERCE_HMAC_SECRET=REPLACE_WITH_UNIQUE_RANDOM_VALUE_AT_LEAST_32_BYTES
COMMERCE_HMAC_SECRET_ROTATED_AT=REPLACE_WITH_RFC3339_UTC
ADMIN_HMAC_SECRET=REPLACE_WITH_UNIQUE_RANDOM_VALUE_AT_LEAST_32_BYTES
ADMIN_HMAC_SECRET_ROTATED_AT=REPLACE_WITH_RFC3339_UTC
NNOBOA_INVITE_SECRET=REPLACE_WITH_UNIQUE_RANDOM_VALUE_AT_LEAST_32_BYTES
NNOBOA_INVITE_SECRET_ROTATED_AT=REPLACE_WITH_RFC3339_UTC
SEED_HMAC_SECRET=REPLACE_WITH_UNIQUE_RANDOM_VALUE_AT_LEAST_32_BYTES
SEED_HMAC_SECRET_ROTATED_AT=REPLACE_WITH_RFC3339_UTC
CIRCLE_HMAC_SECRET=REPLACE_WITH_UNIQUE_RANDOM_VALUE_AT_LEAST_32_BYTES
CIRCLE_HMAC_SECRET_ROTATED_AT=REPLACE_WITH_RFC3339_UTC
FEATURE_SOW_ENABLED=true
FEATURE_FIRES_ENABLED=true
FEATURE_PAYMENTS_ENABLED=false
FEATURE_GATE_ENABLED=true
FEATURE_AI_ENABLED=false
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Outbound delivery providers. The API refuses to start in production if any
# channel is left on the simulator: the simulator reports every message as
# delivered while transmitting nothing.
OTP_PROVIDERS=arkesel
ARKESEL_API_KEY=REPLACE_WITH_ARKESEL_API_KEY
# Pre-approved alphanumeric sender id, at most 11 characters.
ARKESEL_SENDER_ID=Obiara
# Must contain exactly one %s, which is replaced by the code.
OTP_SMS_TEMPLATE=%s is your Obiara code. It expires in 10 minutes. Obiara will never ask you for this code.
EMAIL_PROVIDER=resend
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
# Must be an address on a domain verified in Resend.
RESEND_FROM_ADDRESS=REPLACE_WITH_VERIFIED_SENDER
RESEND_REPLY_TO=
# "disabled" fails every WhatsApp send loudly and delivery-logs it. Switch to
# "meta" only once the Cloud API is provisioned; never use "simulator" here.
WHATSAPP_PROVIDER=disabled
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_API_VERSION=v21.0
META_WHATSAPP_LANGUAGE=en

# Identity and liveness providers. "manual" routes every case to the admin
# review desk. The simulator auto-approves any Ghana Card and passes any
# liveness attempt, so it is rejected outside development.
IDENTITY_VERIFICATION_PROVIDER=manual
LIVENESS_PROVIDER=manual

# Device push. "expo" delivers through exp.host. "disabled" fails every push
# loudly so the ladder falls through to the in-app inbox. Never "simulator".
PUSH_PROVIDER=expo
# Only required when the Expo project enables enhanced security.
EXPO_ACCESS_TOKEN=

# The weekly seed allowance: server-authoritative and non-purchasable, the
# main lever on how much reaching-out the platform permits. Review before
# sowing is enabled — the default is a placeholder, not a product decision.
SEED_WEEKLY_ALLOWANCE=3
SEED_WEEK_TIMEZONE=Africa/Accra
