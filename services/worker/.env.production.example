# Render Environment variables for obiara-worker-production.
APP_ENV=production
MONGODB_DATABASE=obiara_production
MONGODB_URI=REPLACE_WITH_WORKER_LEAST_PRIVILEGE_MONGODB_URI
MONGODB_URI_ROTATED_AT=REPLACE_WITH_RFC3339_UTC
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false
# Startup and shutdown budgets. Both are honoured by the worker; a cold or
# shared Atlas cluster can exceed a ten-second connect budget, and exceeding
# it fails startup, which on Render is a crash loop.
MONGO_CONNECT_TIMEOUT=30s
SHUTDOWN_TIMEOUT=20s
