{
  "name": "@obiara/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "build": "pnpm run contract:check && tsc --noEmit",
    "contract:check": "node scripts/generate.mjs --check",
    "contract:generate": "node scripts/generate.mjs",
    "lint": "redocly lint ../../services/api/openapi/openapi.yaml --config redocly.yaml",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@obiara/config-typescript": "workspace:*",
    "@redocly/cli": "2.40.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
